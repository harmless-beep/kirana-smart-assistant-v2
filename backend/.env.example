# ─── REQUIRED (production & local) ──────────────────────────────
# PostgreSQL connection string. Leave empty for local SQLite fallback.
DATABASE_URL=

# JWT signing secret — use a long random string.
# Generate one with:  openssl rand -base64 64
JWT_SECRET_KEY=replace-with-a-long-random-string

# ─── OPTIONAL ───────────────────────────────────────────────
# CORS allowed origins (comma-separated). Leave empty for built-in defaults:
#   http://localhost:5173, http://localhost:3000, http://localhost:8000,
#   https://harmless-beep.github.io
CORS_ORIGINS=

# JWT algorithm
ALGORITHM=HS256

# Token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Smart Assistant (optional AI chat) ──────────────────────
# Primary: Gemini free tier — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fallback: OpenCode Zen — https://opencode.ai/zen
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=mimo-v2.5
