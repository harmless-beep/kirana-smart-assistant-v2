# ─── REQUIRED (production) ──────────────────────────────────────
# Supabase PostgreSQL connection string.
# Get it from: Supabase Dashboard → Settings → Database → Connection URI
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# JWT signing secret — generate with: openssl rand -base64 64
JWT_SECRET_KEY=

# ─── REQUIRED (production) ──────────────────────────────────────
# CORS allowed origins (comma-separated).
# For Fly.io + GitHub Pages:
CORS_ORIGINS=https://harmless-beep.github.io

# ─── OPTIONAL ───────────────────────────────────────────────
# JWT algorithm
ALGORITHM=HS256

# Token lifetime in minutes (7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Smart Assistant (optional AI chat) ──────────────────────
# Gemini free tier — get a key at https://aistudio.google.com/apikey
# 15 requests/min, 1M tokens/day — more than enough for a shop assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
