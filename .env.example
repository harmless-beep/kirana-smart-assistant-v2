[TEMPLATE]
# ===========================================
# Kirana Smart Assistant — Environment Variables
# ===========================================
# Copy this file to .env and fill in values:
#   cp .env.example .env

# --- Database ---
# Leave empty to use local SQLite (backend/kirana.db)
DATABASE_URL=

# PostgreSQL credentials (only needed if using Docker Compose)
POSTGRES_USER=kirana
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=kirana_db

# --- Authentication ---
# Generate with: openssl rand -base64 64
JWT_SECRET_KEY=change-me-to-a-random-secret

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AI Assistant (optional) ---
# Preferred: Gemini free tier (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Fallback: OpenCode Zen (https://opencode.ai/zen)
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=mimo-v2.5

# --- App ---
APP_PORT=8000
ACCESS_TOKEN_EXPIRE_MINUTES=10080
